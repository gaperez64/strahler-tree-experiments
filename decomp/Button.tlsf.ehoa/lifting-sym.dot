digraph attractor_decompositions {
  graph [rankdir=TB, ordering=out];
  node [shape=box];
  result [label="result (synthetic)"];
  result -> even;
  even [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><B>Even</B> <I>d</I> = 4</TD></TR><TR><TD>|<I>W</I>| = 4</TD><TD>|<I>A</I>| = 4</TD></TR><TR><TD>nodes = 1</TD><TD>leaves = 1</TD></TR><TR><TD>height = 1</TD><TD>Strahler = 1</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>W</I> = {0,2,3,6}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>A</I> = {0,2,3,6}</TD></TR></TABLE>>];
  result -> odd;
  odd [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><B>Odd</B> <I>d</I> = 5</TD></TR><TR><TD>|<I>W</I>| = 3</TD><TD>|<I>A</I>| = 0</TD></TR><TR><TD>nodes = 2</TD><TD>leaves = 1</TD></TR><TR><TD>height = 2</TD><TD>Strahler = 1</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>W</I> = {1,4,5}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>A</I> = {}</TD></TR></TABLE>>];
  odd -> odd_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><I>i</I> = 1</TD></TR><TR><TD>|<I>S</I><SUB><I>i</I></SUB>| = 3</TD><TD>|<I>A</I><SUB><I>i</I></SUB>| = 3</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>S</I><SUB><I>i</I></SUB> = {1,4,5}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>A</I><SUB><I>i</I></SUB> = {1,4,5}</TD></TR></TABLE>>];
  odd_0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><B>Odd</B> <I>d</I> = 3</TD></TR><TR><TD>|<I>W</I>| = 3</TD><TD>|<I>A</I>| = 3</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>W</I> = {1,4,5}</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><I>A</I> = {1,4,5}</TD></TR></TABLE>>];
}
