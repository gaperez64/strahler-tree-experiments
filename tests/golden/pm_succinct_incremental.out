digraph progress_measures {
  ordering=out;
  node [shape=box];
  label="round 1";
  result [label="result (synthetic)"];
  result -> n1;
  n1 [label="Even (complete)\nsuccinct bits=1 depth=2\np=3"];
  n1 -> n2 [label="0"];
  n2 [label="p=1"];
  n2 -> n3 [label=""];
  n3 [label="\nV={0,3}"];
  n1 -> n4 [label=""];
  n4 [label="p=1"];
  n4 -> n5 [label="0"];
  n5 [label="\nV={1,2,4}"];
  result -> n6;
  n6 [label="Odd (complete)\nsuccinct bits=1 depth=2\nno non-top measures\nV={}"];
}
