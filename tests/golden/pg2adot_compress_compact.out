digraph attractor_decompositions {
  graph [rankdir=TB, ordering=out];
  node [shape=box];
  result [label="result (synthetic)"];
  result -> even;
  even [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="1"><TR><TD COLSPAN="2"><B>Even</B> <I>d</I> = 2</TD></TR><TR><TD>|<I>W</I>| = 6</TD><TD>|<I>A</I>| = 6</TD></TR><TR><TD>nodes = 1</TD><TD>leaves = 1</TD></TR><TR><TD>height = 1</TD><TD>Strahler = 1</TD></TR></TABLE>>];
  odd_empty [label=<<B>Odd</B>: <I>W</I> = empty; no decomposition>];
  result -> odd_empty;
}
