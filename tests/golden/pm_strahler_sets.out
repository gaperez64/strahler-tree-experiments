digraph progress_measures {
  ordering=out;
  node [shape=box];
  result [label="result (synthetic)"];
  result -> n1;
  n1 [label="Even (complete)\nstrahler k=2 t=1 depth=2\np=3"];
  n1 -> n2 [label="00"];
  n2 [label="p=1"];
  n2 -> n3 [label=""];
  n3 [label="\nV={0,..., +1 more}"];
  n1 -> n4 [label="0"];
  n4 [label="p=1"];
  n4 -> n5 [label=""];
  n5 [label="\nV={1,..., +2 more}"];
  result -> n6;
  n6 [label="Odd (complete)\nstrahler k=2 t=1 depth=2\nno non-top measures\nV={}"];
}
