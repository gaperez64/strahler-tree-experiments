lifting: vertices=5 t_full=2 result=complete
iter-shave: rounds=2
iter-shave: round=1 shaved=3 even=3 odd=0
iter-shave: round=2 shaved=2 even=2 odd=0
lifting even: root_level=4 H=3 k_full=3 host=kary arity=1 host_nodes=3 host_leaves=1 positions=9 rounds=1 lifts=2 top=0 region=2 tree_nodes=2 tree_leaves=1 tree_height=2 strahler=1
lifting odd: root_level=3 H=2 k_full=2 host=kary arity=1 host_nodes=2 host_leaves=1 positions=6 rounds=3 lifts=5 top=2 region=0 tree_nodes=0 tree_leaves=0 tree_height=0 strahler=0
start: vertex=0 winner=even
digraph attractor_decompositions {
  graph [rankdir=TB, ordering=out, newrank=true];
  node [shape=box];
  result [label="result (synthetic)"];
  result -> even;
  even [label=<<B>Even</B><BR/><I>H</I> = {}<BR/><FONT POINT-SIZE="10">base tree: 2 nodes; 1 leaf; height 2; Strahler 1</FONT>>];
  even -> even_0 [label=<1>, minlen=2];
  even_0 [label=<<I>H</I> = {1}>];
  even_0 -> even_0_mininf [label=<&minus;&infin;>];
  even_0_mininf [shape=ellipse, label=<<I>T</I> = {2}>];
  even_shaved_1 [style="dashed,filled", fillcolor=lightgray, label=<<B>shaved (Even)</B>, round 1: 3 vertices<BR/>{0,3,4}>];
  even -> even_shaved_1 [style=dashed];
  even_shaved_1 -> even_round_1;
  even_round_1 [label=<<B>Even dominion</B><BR/><I>H</I> = {}<BR/><FONT POINT-SIZE="10">base tree: 3 nodes; 1 leaf; height 3; Strahler 1</FONT>>];
  even_round_1 -> even_round_1_0 [label=<1>, minlen=2];
  even_round_1 -> even_round_1_0_plus [label=<1<SUP>+</SUP>>];
  even_round_1_0_plus [shape=ellipse, label=<<I>S</I><SUB>1</SUB> = {4}>];
  even_round_1_0 [label=<<I>H</I> = {0}>];
  even_round_1_0 -> even_round_1_0_0 [label=<1>, minlen=2];
  even_round_1_0_0 [label=<<I>H</I> = {3}>];
  odd_empty [label=<<B>Odd</B>: <I>W</I> = empty; no decomposition>];
  result -> odd_empty;
  jurdzinski_level_4 [shape=plaintext, label=<<I>level</I> = 4>];
  { rank=same; jurdzinski_level_4; even; even_round_1; }
  jurdzinski_level_3 [shape=plaintext, label=<<I>level</I> = 3>];
  { rank=same; jurdzinski_level_3; even_round_1_0_plus; }
  jurdzinski_level_2 [shape=plaintext, label=<<I>level</I> = 2>];
  { rank=same; jurdzinski_level_2; even_0; even_round_1_0; }
  jurdzinski_level_1 [shape=plaintext, label=<<I>level</I> = 1>];
  { rank=same; jurdzinski_level_1; even_0_mininf; }
  jurdzinski_level_0 [shape=plaintext, label=<<I>level</I> = 0>];
  { rank=same; jurdzinski_level_0; even_round_1_0_0; }
  jurdzinski_level_4 -> jurdzinski_level_3 [style=invis, weight=100];
  jurdzinski_level_3 -> jurdzinski_level_2 [style=invis, weight=100];
  jurdzinski_level_2 -> jurdzinski_level_1 [style=invis, weight=100];
  jurdzinski_level_1 -> jurdzinski_level_0 [style=invis, weight=100];
}
