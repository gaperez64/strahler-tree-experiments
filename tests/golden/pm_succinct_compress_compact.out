  n3 [label="\n|V|=1"];
  n1 -> n4 [label="1"];
  n4 [label="\n|V|=1"];
  result -> n5;
  n5 [label="Odd (complete)\nsuccinct bits=1 depth=2\nno non-top measures\n|V|=0"];
}
