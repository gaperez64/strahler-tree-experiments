digraph progress_measures {
  ordering=out;
  node [shape=box];
  result [label="result (synthetic; partial)"];
  result -> n1;
  n1 [label="Even (partial)\nsuccinct bits=0 depth=2\np=3"];
  n1 -> n2 [label=""];
  n2 [label="p=1"];
  n2 -> n3 [label=""];
  n3 [label="\nV={0,3}"];
  result -> n4;
  n4 [label="Odd (partial)\nsuccinct bits=0 depth=2\nno non-top measures\nV={}"];
  unresolved [style=dashed, label="Unresolved\nU={1,2,4}"];
  result -> unresolved [style=dashed];
}
