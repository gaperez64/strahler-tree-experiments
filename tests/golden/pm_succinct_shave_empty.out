digraph progress_measures {
  ordering=out;
  node [shape=box];
  result [label="result (synthetic)"];
  result -> n1;
  n1 [label="Even (complete)\nsuccinct bits=0 depth=0\nno non-top measures\nV={}"];
  n2 [style=filled, fillcolor=lightgrey, label="shaved (Even)\nW={0,1,2}"];
  n1 -> n2 [style=dashed];
  result -> n3;
  n3 [label="Odd (complete)\nsuccinct bits=0 depth=1\nno non-top measures\nV={}"];
}
